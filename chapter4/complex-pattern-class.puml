@startuml complex-pattern-class

!theme plain
skinparam backgroundColor #FFFFFF
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #000000
skinparam InterfaceBackgroundColor #FFFFFF
skinparam InterfaceBorderColor #000000
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #000000

title Chart Pattern Detection Services Class Diagram

class ChartPatternDetectionService {
    - candleStickService: CandleStickService
    - flagPatternService: FlagPatternService
    - doublePatternService: DoublePatternService
    - headAndShouldersService: HeadAndShouldersService
    - inverseHeadAndShouldersService: InverseHeadAndShouldersService
    - pennantService: PennantService
    - triangleService: TriangleService
    __
    + analyzeAllPatterns(stockId: String): ChartPatternResult
}

interface ComplexPatternDetectorService {
    + getNearestCupWithHandle(smaValues: List<Double>): CupWithHandle
}

class HeadAndShouldersService {
    + findHeadAndShouldersPatterns(ohlcDataList, lookback, pivotInterval, ...): List<HeadAndShouldersPattern>
}

class DoublePatternService {
    + findDoubleTopPatterns(ohlcDataList, ...): List<DoublePattern>
    + findDoubleBottomPatterns(ohlcDataList, ...): List<DoublePattern>
}

class TriangleService {
    + findTrianglePatterns(ohlcDataList, ...): List<TrianglePattern>
}

class FlagPatternService {
    + findFlagPatterns(ohlcDataList, ...): List<FlagPattern>
}

class PennantService {
    + findPennantPatterns(ohlcDataList, ...): List<PennantPattern>
}

class ChartPatternResult {
    - stockSymbol: String
    - analysisTime: Long
    - flagPatterns: List<FlagPattern>
    - doublePatterns: List<DoublePattern>
    - headAndShouldersPatterns: List<HeadAndShouldersPattern>
    - inverseHeadAndShouldersPatterns: List<InverseHeadAndShouldersPattern>
    - pennantPatterns: List<PennantPattern>
    - trianglePatterns: List<TrianglePattern>
    - totalPatternsFound: int
}

class CupWithHandle {
    - cupStart: int
    - cupBottom: int
    - cupEnd: int
    - handleEnd: int
    - breakoutPoint: int
}

ChartPatternDetectionService --> HeadAndShouldersService
ChartPatternDetectionService --> DoublePatternService
ChartPatternDetectionService --> TriangleService
ChartPatternDetectionService --> FlagPatternService
ChartPatternDetectionService --> PennantService
ChartPatternDetectionService ..> ChartPatternResult : creates
ComplexPatternDetectorService ..> CupWithHandle : returns

@enduml
