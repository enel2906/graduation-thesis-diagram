@startuml stock-listener-class

!theme plain
skinparam backgroundColor #FFFFFF
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 11

title StockDataListener Class Diagram

class StockDataListener {
    - candleStickService: CandleStickService
    - stockRepository: StockRepository
    - objectMapper: ObjectMapper
    __
    + handleStockUpdate(message: String): void
    - processCandle(stockUpdate: StockUpdateDTO): void
    - parseMessage(message: String): StockUpdateDTO
    - upsertCandlestick(candle: CandleStick): void
}

class StockUpdateDTO {
    - symbol: String
    - timestamp: Long
    - open: Double
    - high: Double
    - low: Double
    - close: Double
    - volume: Long
    - dateStr: String
}

class CandleStickService {
    - candleStickRepository: CandleStickRepository
    - stockRepository: StockRepository
    __
    + getCandlesticks(symbol: String): List<CandleStick>
    + getCandlesticksByRange(symbol: String, start: LocalDate, end: LocalDate): List<CandleStick>
    + saveCandlestick(candle: CandleStick): CandleStick
    + upsertCandlestick(candle: CandleStick): CandleStick
}

class RabbitMQConfig <<@Configuration>> {
    + {static} EXCHANGE_NAME: String = "stock.market.data"
    + {static} QUEUE_NAME: String = "stock.live.updates"
    + {static} ROUTING_KEY_PATTERN: String = "stock.update.*"
    __
    + stockExchange(): TopicExchange
    + stockQueue(): Queue
    + binding(Queue, TopicExchange): Binding
    + jsonMessageConverter(): MessageConverter
    + rabbitTemplate(ConnectionFactory): RabbitTemplate
}

queue "RabbitMQ\nstock.live.updates" as rabbitmq

rabbitmq --> StockDataListener : "@RabbitListener"
StockDataListener --> CandleStickService
StockDataListener ..> StockUpdateDTO : parses
CandleStickService --> CandleStick : manages

note right of StockDataListener
    Listens to RabbitMQ queue
    "stock.live.updates"
    Processes real-time stock updates
    from Data Service
end note

note bottom of RabbitMQConfig
    Topic Exchange: stock.market.data
    Routing Pattern: stock.update.*
    (matches stock.update.VIC, 
    stock.update.FPT, etc.)
end note

@enduml
