@startuml stock-listener-class

!theme plain
allowmixing
skinparam backgroundColor #FFFFFF
skinparam classAttributeIconSize 0
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #000000
skinparam InterfaceBackgroundColor #FFFFFF
skinparam InterfaceBorderColor #000000
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #000000
skinparam QueueBackgroundColor #FFFFFF
skinparam QueueBorderColor #000000

title StockDataListener Class Diagram

class StockDataListener {
    - messagingTemplate: SimpMessagingTemplate
    - connectionFactory: ConnectionFactory
    __
    + onApplicationReady(): void
    + receiveStockUpdate(stockUpdate: StockUpdateDTO): void
}

class StockUpdateDTO {
    - symbol: String
    - timestamp: Long
    - open: Double
    - high: Double
    - low: Double
    - close: Double
    - volume: Long
    - dateStr: String
}

class RabbitMQConfig <<@Configuration>> {
    + {static} EXCHANGE_NAME: String = "stock.market.data"
    + {static} QUEUE_NAME: String = "stock.live.updates"
    + {static} ROUTING_KEY_PATTERN: String = "stock.update.*"
    __
    + stockExchange(): TopicExchange
    + stockQueue(): Queue
    + binding(Queue, TopicExchange): Binding
    + jsonMessageConverter(): MessageConverter
    + rabbitTemplate(ConnectionFactory): RabbitTemplate
}

class SimpMessagingTemplate {
    + convertAndSend(destination: String, payload: Object): void
}

queue "RabbitMQ\nstock.live.updates" as rabbitmq

rabbitmq --> StockDataListener : "@RabbitListener"
StockDataListener --> SimpMessagingTemplate : broadcasts
StockDataListener ..> StockUpdateDTO : receives

note right of StockDataListener
    Listens to RabbitMQ queue
    "stock.live.updates"
    Broadcasts updates to
    WebSocket clients via
    SimpMessagingTemplate
end note

note bottom of RabbitMQConfig
    Topic Exchange: stock.market.data
    Routing Pattern: stock.update.*
    (matches stock.update.VIC, 
    stock.update.FPT, etc.)
end note

@enduml
