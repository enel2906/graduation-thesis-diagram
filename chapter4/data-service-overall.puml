@startuml data-service-overall

!theme plain
skinparam backgroundColor #FFFFFF
skinparam componentStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam RectangleBackgroundColor #FFFFFF
skinparam RectangleBorderColor #000000
skinparam ComponentBackgroundColor #FFFFFF
skinparam ComponentBorderColor #000000
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #000000
skinparam CloudBackgroundColor #FFFFFF
skinparam CloudBorderColor #000000
skinparam DatabaseBackgroundColor #FFFFFF
skinparam DatabaseBorderColor #000000
skinparam QueueBackgroundColor #FFFFFF
skinparam QueueBorderColor #000000

title Data Service Overall Design

rectangle "Data Service (Python FastAPI)" #FFFFFF {
    
    rectangle "API Layer" {
        [REST API Endpoints] as api
        note right of api
            /api/candlesticks/{symbol}
            /api/stocks
            /api/company/{symbol}
            /api/financial/{symbol}
            /api/admin/stocks
        end note
    }
    
    rectangle "Business Logic Layer" {
        [Data Fetcher] as fetcher
        [Background Tasks] as tasks
        [Stock Updater] as updater
    }
    
    rectangle "Integration Layer" {
        [vnstock Client] as vnstockClient
        [yfinance Client] as yfinanceClient
        [RabbitMQ Publisher] as publisher
    }
    
    rectangle "Data Access Layer" {
        [MongoDB Repository] as repo
    }
}

cloud "External APIs" {
    [vnstock] as vnstockApi
    [yfinance] as yfinanceApi
}

database "MongoDB" as mongodb

queue "RabbitMQ" as rabbitmq

' Connections
api --> fetcher
api --> repo

tasks --> updater
updater --> fetcher
updater --> publisher

fetcher --> vnstockClient
fetcher --> yfinanceClient
fetcher --> repo

vnstockClient --> vnstockApi
yfinanceClient --> yfinanceApi

repo --> mongodb
publisher --> rabbitmq

@enduml
