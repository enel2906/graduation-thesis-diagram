@startuml deployment-diagram-v2

!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam NodeBackgroundColor #FFFFFF
skinparam NodeBorderColor #000000
skinparam ComponentBackgroundColor #FFFFFF
skinparam ComponentBorderColor #000000
skinparam DatabaseBackgroundColor #FFFFFF
skinparam DatabaseBorderColor #000000
skinparam CloudBackgroundColor #FFFFFF
skinparam CloudBorderColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #000000
skinparam FrameBackgroundColor #FFFFFF
skinparam FrameBorderColor #000000

title Deployment Architecture Diagram

actor "User\n(Chrome Browser)" as user

node "Local Development Machine (Windows 11)" as devMachine {
    
    frame "Docker Container" as docker {
        component "RabbitMQ 3.x\n[Message Broker]\nAMQP: 5672\nManagement: 15672" as rabbitmq
    }
    
    frame "Local Services" as localServices {
        database "MongoDB 7.0\n[Database]\nPort: 27017" as mongodb
        
        component "Data Service\n[Python FastAPI]\nPort: 8000" as dataService
        
        component "Alert Service\n[Spring Boot 3.3]\nPort: 60" as alertService
        
        component "React Client\n[Vite Dev Server]\nPort: 5173" as reactClient
    }
}

cloud "External APIs" as external {
    component "vnstock API\n[Stock Data]" as vnstock
    component "Google OAuth2\n[Authentication]" as google
}

' User connections
user --> reactClient : "HTTP :5173"

' Internal connections
reactClient --> dataService : "REST :8000"
reactClient --> alertService : "REST :60"
alertService --> reactClient : "WebSocket :60/ws"

dataService --> mongodb : "pymongo"
alertService --> mongodb : "Spring Data"

dataService --> rabbitmq : "aio_pika"
alertService --> rabbitmq : "Spring AMQP"

' External connections
dataService --> vnstock : "HTTP/REST"
alertService --> google : "OAuth2"

note bottom of docker
    **Docker command:**
    docker run -d --name rabbitmq \
    -p 5672:5672 -p 15672:15672 \
    rabbitmq:3-management
end note

note bottom of localServices
    **All services run locally:**
    - MongoDB: installed on machine
    - Python 3.11: FastAPI server
    - Java 17: Spring Boot application
    - Node.js 20: Vite dev server
end note

@enduml
