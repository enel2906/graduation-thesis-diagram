@startuml react-client-package

!theme plain
skinparam backgroundColor #FFFFFF
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam PackageBackgroundColor #FFFFFF
skinparam PackageBorderColor #000000
skinparam ClassBackgroundColor #FFFFFF
skinparam ClassBorderColor #000000
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #000000

title React Client Package Design

package "react-client/src" {
    
    package "components" #FFFFFF {
        class Header {
            + navigation
            + search
            + theme toggle
            + auth status
        }
        
        class StockChart {
            + candlestick chart
            + pattern markers
            + indicator overlays
            + volume bars
        }
        
        class IndicatorsModal {
            + SMA/EMA config
            + RSI config
            + MACD config
            + Bollinger config
        }
        
        class AdvanceSignalModal {
            + combo signals
            + backtest results
        }
        
        class NewsModal {
            + news list
            + news detail
        }
        
        class FinancialReportModal {
            + financial ratios
            + balance sheet
        }
        
        class StockSearchModal {
            + search input
            + results list
        }
        
        package "auth" {
            class LoginForm
            class RegisterForm
        }
    }
    
    package "pages" #FFFFFF {
        class AuthPage
        class AuthCallbackPage
        class WatchlistPage
        class AdminPage
        class AboutPage
    }
    
    package "services" #FFFFFF {
        class apiService {
            + getCandlesticks()
            + getStocks()
            + getPatterns()
            + getNews()
            + getFinancials()
        }
        
        class authService {
            + login()
            + register()
            + refreshToken()
            + logout()
        }
        
        class websocketService {
            + connect()
            + subscribe()
            + disconnect()
        }
        
        class watchlistApi {
            + getPriceBoard()
            + getWatchlist()
            + addToWatchlist()
            + removeFromWatchlist()
        }
        
        class patternDetectionService {
            + detectCandlePattern()
            + getSupportedPatterns()
            + isPatternSupported()
        }
        
        class advanceSignalService {
            + detectComboSignal()
            + checkRealtimeSignals()
            + generateBacktestMarkers()
        }
        
        class technicalIndicators {
            + calculateSMA()
            + calculateEMA()
            + calculateRSI()
            + calculateMACD()
            + calculateBollingerBands()
            + calculateATR()
        }
    }
    
    package "context" #FFFFFF {
        class AuthContext {
            + user
            + isAuthenticated
            + login()
            + logout()
        }
    }
    
    package "constants" #FFFFFF {
        class patternDefinitions {
            + singlePatterns
            + doublePatterns
            + triplePatterns
            + complexPatterns
        }
        
        class comboSignalDefinitions {
            + COMBO_SIGNALS
            + getComboSignal()
            + getAllComboSignals()
        }
        
        class indicatorOptions {
            + trendIndicators
            + momentumIndicators
            + volatilityIndicators
        }
    }
    
    package "utils" #FFFFFF {
        class patternUtils {
            + getPatternAbbreviation()
            + getPatternSentiment()
            + isValidData()
        }
        
        class customMarkers {
            + createPatternMarker()
            + createSignalMarker()
        }
    }
    
    class App {
        + routing
        + state management
        + theme handling
    }
}

' Relationships
App --> Header
App --> StockChart
App --> AuthContext

Header --> StockSearchModal
Header --> authService

StockChart --> patternDetectionService
StockChart --> technicalIndicators
StockChart --> patternDefinitions

IndicatorsModal --> technicalIndicators
AdvanceSignalModal --> advanceSignalService
AdvanceSignalModal --> comboSignalDefinitions

AuthPage --> authService
AuthPage --> AuthContext

WatchlistPage --> watchlistApi
WatchlistPage --> websocketService
WatchlistPage --> AuthContext

@enduml
