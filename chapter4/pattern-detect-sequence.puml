@startuml pattern-detect-sequence

!theme plain
skinparam backgroundColor #FFFFFF
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam sequenceMessageAlign center
skinparam ParticipantBackgroundColor #FFFFFF
skinparam ParticipantBorderColor #000000
skinparam ActorBackgroundColor #FFFFFF
skinparam ActorBorderColor #000000
skinparam NoteBackgroundColor #FFFFFF
skinparam NoteBorderColor #000000
skinparam SequenceLifeLineBorderColor #000000

title Sequence Diagram - Pattern Detection Flow (Client-side)

actor "User" as user
participant "React Client\n(StockChart)" as client
participant "PatternDetectionService\n(JavaScript)" as patternService
participant "CandlePatternDetector" as detector
participant "Alert Service\n(Fallback API)" as alertService

user -> client : Select pattern "Hammer"
activate client

client -> patternService : detectCandlePattern(candles, "hammer")
activate patternService

patternService -> patternService : Check if pattern\nis supported locally

alt Pattern supported (client-side detection)
    patternService -> detector : detectHammer(candles)
    activate detector
    
    note right of detector
        For each candlestick:
        1. Calculate body size
        2. Calculate lower shadow
        3. Calculate upper shadow
        4. Check hammer criteria:
           - Lower shadow >= 2x body
           - Upper shadow <= 10% of range
           - Body in upper third
           - Downtrend before pattern
    end note
    
    detector -> detector : filter candles matching\nHammer pattern criteria
    
    detector --> patternService : patterns[]
    deactivate detector
    
else Pattern not supported locally (fallback to API)
    patternService -> alertService : GET /alert/candle-stick/{symbol}\n?candlePattern=pattern_name
    activate alertService
    alertService --> patternService : PatternResponse
    deactivate alertService
end

patternService --> client : patterns[] (matched candles)
deactivate patternService

client -> client : Generate markers for\nmatched patterns

client -> client : Add markers to chart\nusing lightweight-charts

client --> user : Display chart with\npattern markers highlighted
deactivate client

@enduml
