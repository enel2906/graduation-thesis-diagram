@startuml
!theme plain
title Stock Chart Interaction
left to right direction

actor "User" as User #LightBlue
actor "Chart Library" as Chart #LightGreen

rectangle "Chart Interaction" {
    
    package "Stock Selection" #LightCyan {
        usecase "Search Stock" as UC01
        usecase "Select Symbol" as UC02
        usecase "Load OHLC" as UC03
        usecase "Initialize Chart" as UC04
    }
    
    package "Pattern Selection" #LightYellow {
        usecase "Open Indicators" as UC05
        usecase "Browse Categories" as UC06
        usecase "Search Pattern" as UC07
        usecase "Multi-Select" as UC08
        usecase "Apply Patterns" as UC09
    }
    
    package "Visualization" #Lavender {
        usecase "Render Candles" as UC10
        usecase "Draw Markers" as UC11
        usecase "Show Tooltips" as UC12
        usecase "Color Coding" as UC13
    }
    
    package "Navigation" #LightSalmon {
        usecase "Zoom" as UC14
        usecase "Pan" as UC15
        usecase "Reset View" as UC16
    }
    
    package "Time Range" #Wheat {
        usecase "Select Period" as UC17
        usecase "Custom Range" as UC18
    }
    
    package "Theme" #MistyRose {
        usecase "Toggle Mode" as UC19
        usecase "Adjust Colors" as UC20
    }
}

' Relationships
User --> UC01
UC01 ..> UC02 : <<include>>
UC02 ..> UC03 : <<include>>
UC03 ..> UC04 : <<include>>
UC04 --> Chart

User --> UC05
UC05 ..> UC06 : <<include>>
UC05 ..> UC07 : <<extend>>
UC06 ..> UC08 : <<include>>
UC08 ..> UC09 : <<include>>

UC09 ..> UC10 : <<include>>
UC10 --> Chart
UC09 ..> UC11 : <<include>>
UC11 --> Chart
UC11 ..> UC12 : <<include>>
UC11 ..> UC13 : <<include>>

User --> UC14
UC14 --> Chart
User --> UC15
UC15 --> Chart
User --> UC16
UC16 --> Chart

User --> UC17
User --> UC18
User --> UC19
UC19 ..> UC20 : <<include>>

note right of UC01
  Search by symbol/name
  Filter by market
  30+ VN + 6 US stocks
end note

note right of UC06
  49 Candle Patterns
  12 Chart Patterns
  Technical Indicators
end note

note right of UC11
  Markers: ▲ bullish, ▼ bearish
  Green/Red colors
  Position: above/below candle
end note

note bottom of UC17
  Presets: 1M, 3M, 6M, 1Y, ALL
  Custom date picker
  Data: Up to 10 years
end note

@enduml

