@startuml Authentication Use Case
skinparam backgroundColor white
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam usecaseBackgroundColor #E8F4FD
skinparam usecaseBorderColor #2196F3

title Authentication Module - Detailed Use Case

left to right direction

actor "User" as User #LightBlue
actor "Google OAuth" as Google #LightCoral

rectangle "Authentication System" {
    usecase "Register with Email" as UC1
    usecase "Login with Credentials" as UC2
    usecase "Login with Google OAuth" as UC3
    usecase "Logout" as UC4
    usecase "Validate JWT Token" as UC5
    usecase "Refresh Access Token" as UC6
    
    UC2 ..> UC5 : <<include>>
    UC3 ..> UC5 : <<include>>
    UC5 ..> UC6 : <<extend>>
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4

Google <-- UC3 : OAuth2 Flow

note right of UC5
  JWT tokens include:
  - Access Token (30min)
  - Refresh Token (7 days)
end note

@enduml
