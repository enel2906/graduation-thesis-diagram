@startuml Technical Analysis Use Case
skinparam backgroundColor white
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam usecaseBackgroundColor #E8F4FD
skinparam usecaseBorderColor #2196F3

title Technical Analysis Module - Detailed Use Case

left to right direction

actor "User" as User #LightBlue

rectangle "Technical Indicators" as TI {
    usecase "Select Indicators" as UC1
    usecase "View Moving Averages\n(SMA, EMA)" as UC2
    usecase "View RSI" as UC3
    usecase "View MACD" as UC4
    usecase "View Bollinger Bands" as UC5
    usecase "View Volume Analysis" as UC6
}

rectangle "Advance Signals" as AS {
    usecase "Configure Combo Signals" as UC7
    usecase "Run Backtest" as UC8
    usecase "View Signal Results" as UC9
    usecase "Clear Signals" as UC10
    
    UC7 ..> UC8 : <<extend>>
    UC8 ..> UC9 : <<include>>
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
User --> UC7
User --> UC10

UC1 ..> UC2 : <<extend>>
UC1 ..> UC3 : <<extend>>
UC1 ..> UC4 : <<extend>>
UC1 ..> UC5 : <<extend>>
UC1 ..> UC6 : <<extend>>

@enduml
