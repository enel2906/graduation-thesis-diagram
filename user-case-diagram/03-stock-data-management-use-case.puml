@startuml
!theme plain
title Stock Data Management
left to right direction

actor "Data Service" as DataService #LightGreen
actor "VnStock API" as VnStock #Yellow
actor "MongoDB" as MongoDB #Pink
actor "RabbitMQ" as RabbitMQ #LightBlue

rectangle "Data Management System" {
    
    package "Data Collection" #LightCyan {
        usecase "Fetch VN Stocks" as UC01
        usecase "Fetch US Stocks" as UC02
        usecase "Parse OHLC" as UC03
        usecase "Validate Data" as UC04
    }
    
    package "Storage" #LightYellow {
        usecase "Create Composite ID" as UC05
        usecase "Bulk Upsert" as UC06
        usecase "Update Indexes" as UC07
    }
    
    package "Periodic Update" #Lavender {
        usecase "Background Task" as UC08
        usecase "Incremental Sync" as UC09
        usecase "Loop Stocks" as UC10
    }
    
    package "Publishing" #LightSalmon {
        usecase "Format Message" as UC11
        usecase "Publish to MQ" as UC12
    }
    
    package "APIs" #Wheat {
        usecase "GET /api/stocks" as UC13
        usecase "GET /api/candlesticks" as UC14
        usecase "POST /api/admin/stocks" as UC15
        usecase "GET /api/company/news" as UC16
        usecase "GET /api/company/financial" as UC17
    }
}

' Relationships
DataService --> UC01
UC01 --> VnStock
UC01 ..> UC03 : <<include>>

DataService --> UC02
UC02 ..> UC03 : <<include>>
UC03 ..> UC04 : <<include>>

UC04 ..> UC05 : <<include>>
UC05 ..> UC06 : <<include>>
