@startuml
!theme plain
title Real-Time Data Pipeline
left to right direction

actor "User" as User #LightBlue
actor "Python Service" as Python #LightGreen
actor "Java Service" as Java #Orange
actor "RabbitMQ" as RabbitMQ #Pink

rectangle "Real-Time Pipeline" {
    
    package "Publishing" #LightCyan {
        usecase "Fetch OHLC" as UC01
        usecase "Transform to JSON" as UC02
        usecase "Publish to MQ" as UC03
    }
    
    package "Message Broker" #LightYellow {
        usecase "Route Messages" as UC04
        usecase "Queue Management" as UC05
        usecase "Persist Messages" as UC06
    }
    
    package "Consumption" #Lavender {
        usecase "Listen Queue" as UC07
        usecase "Deserialize JSON" as UC08
        usecase "Validate Message" as UC09
    }
    
    package "WebSocket" #LightSalmon {
        usecase "Connect WebSocket" as UC10
        usecase "Subscribe Topic" as UC11
        usecase "Broadcast Updates" as UC12
        usecase "Handle Reconnect" as UC13
    }
    
    package "Chart Update" #Wheat {
        usecase "Receive Data" as UC14
        usecase "Update Chart" as UC15
        usecase "Recalculate Indicators" as UC16
        usecase "Re-detect Patterns" as UC17
    }
    
    package "Connection" #MistyRose {
        usecase "Monitor Status" as UC18
        usecase "Heartbeat" as UC19
        usecase "Retry Logic" as UC20
    }
}

