@startuml Technical Indicators Use Case
skinparam backgroundColor white
skinparam actorStyle awesome
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam usecaseBackgroundColor #E8F4FD
skinparam usecaseBorderColor #2196F3

title Technical Indicators Module - Detailed Use Case

left to right direction

actor "Registered User" as User #LightBlue

rectangle "Technical Indicators" {
    usecase "Open Indicators Modal" as UC0
    usecase "Select/Deselect Indicators" as UC1
    usecase "View Moving Averages\n(SMA, EMA)" as UC2
    usecase "View RSI\n(Relative Strength Index)" as UC3
    usecase "View MACD\n(Moving Average Convergence Divergence)" as UC4
    usecase "View Bollinger Bands" as UC5
    usecase "View Volume Analysis" as UC6
    usecase "Configure Indicator\nParameters" as UC7
    usecase "Apply Indicators\nto Chart" as UC8
    usecase "Clear All Indicators" as UC9
}

User --> UC0
User --> UC1
User --> UC9

UC0 ..> UC1 : <<include>>

UC1 ..> UC2 : <<extend>>
UC1 ..> UC3 : <<extend>>
UC1 ..> UC4 : <<extend>>
UC1 ..> UC5 : <<extend>>
UC1 ..> UC6 : <<extend>>

UC2 ..> UC7 : <<extend>>
UC3 ..> UC7 : <<extend>>
UC4 ..> UC7 : <<extend>>
UC5 ..> UC7 : <<extend>>

UC1 ..> UC8 : <<include>>

note right of UC7
  Parameters include:
  - Period length (e.g., SMA 20, 50, 200)
  - Overbought/Oversold levels (RSI)
  - Standard deviation (Bollinger)
end note

note bottom of UC2
  Overlay indicators
  displayed on price chart
end note

note bottom of UC3
  Oscillator indicators
  displayed in separate pane
end note

@enduml
