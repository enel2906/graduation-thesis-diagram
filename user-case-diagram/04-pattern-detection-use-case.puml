@startuml
!theme plain
title Pattern Detection System
left to right direction

actor "User" as User #LightBlue
actor "Pattern Engine" as Engine #Yellow

rectangle "Pattern Detection" {
    
    package "Candlestick Patterns" #LightCyan {
        usecase "Single Candle (11)" as UC01
        usecase "Two Candle (15)" as UC02
        usecase "Three Candle (18)" as UC03
        usecase "Multi Candle (5)" as UC04
    }
    
    package "Chart Patterns" #LightYellow {
        usecase "Triangles" as UC05
        usecase "Head & Shoulders" as UC06
        usecase "Double Top/Bottom" as UC07
        usecase "Cup with Handle" as UC08
        usecase "Flag/Pennant" as UC09
    }
    
    package "Detection Process" #Lavender {
        usecase "Load OHLC Data" as UC10
        usecase "Calculate Metrics" as UC11
        usecase "Identify Patterns" as UC12
        usecase "Score Confidence" as UC13
    }
    
    package "Visualization" #LightSalmon {
        usecase "Render Markers" as UC14
        usecase "Draw Lines" as UC15
        usecase "Show Tooltips" as UC16
    }
    
    package "Multi-Selection" #Wheat {
        usecase "Open Indicators Modal" as UC17
        usecase "Search Patterns" as UC18
        usecase "Toggle Selection" as UC19
        usecase "Apply Changes" as UC20
    }
}

